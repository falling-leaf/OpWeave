# === BUILD ARTIFACTS ===
pg_base/
pgdl/build/

# === PAPER ===
pgdl/paper/
# Figure code, paper data, and rendered images stay local
pgdl/visualization/

# === THIRD-PARTY DEPENDENCIES (7+ GB) ===
pgdl/third_party/

# === DATASETS (7.9 GB) ===
# All raw data: images (JPEG/PNG), CSVs, text corpora
pgdl/test/morphingdb_test/data/

# === ML MODEL WEIGHTS (23 GB) ===
# .pt files, HuggingFace model dirs, SentencePiece models
pgdl/test/morphingdb_test/models/
# Small load predictor models are tracked
!pgdl/test/morphingdb_test/models/load_predictors/

# === BUILD OUTPUT ===
# pgdl.so is produced by pgdl/shell/compile.sh; it embeds build-time paths.
pgdl/pgdl.so

# === TEST OUTPUT / RUNTIME CACHE ===
# Everything under pgdl/test/results/ is run output (json/csv/tex/jsonl).
# No source lives there, so the whole tree stays out of git.
pgdl/test/results/
pgdl/test/evadb_data/

# === PYTHON VIRTUAL ENVIRONMENTS ===
.venv/
venv/
**/.venv/
**/venv/

# === PYTHON CACHE ===
**/__pycache__/
**/*.pyc
**/*.pyo

# === EVA DB HASH-NAMED CACHE DIRS (32-char hex) ===
# Created by evadb LOAD IMAGE, accumulate thousands of files
**/results/cache/

# === LOCAL NOTES (never published) ===
notebook.txt
project_overview.md
ANONYMIZATION_INDEX.md

